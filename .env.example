# Example of .env file
# Please rename this file to .env and fill in the placeholders.

# API keys
API_KEY_YOUTUBE="YOUR-API-KEY"  # Get API key from https://console.cloud.google.com For details see https://developers.google.com/youtube/registering_an_application

# Transcript pacing (optional)
# Seconds between each video in `uv run transcripts` (random uniform in [min, max]).
# Lower values speed up fetching but increase IP-block risk. Defaults: 3 and 7.
# min must be >= 0 and max >= min; invalid values fall back to defaults.
TRANSCRIPTS_SLEEP_MIN=3
TRANSCRIPTS_SLEEP_MAX=7

# Summary generation
PROVIDER="deepinfra"                                          # Either ollama, lmstudio, openrouter, openai, together, or deepinfra
MODEL="Qwen/Qwen3-32B"                                        # Model name as specified by the provider

# Provider hosts / base URLs (only the selected PROVIDER's value is used)
OLLAMA_HOST="http://localhost:11434"
LMSTUDIO_HOST="http://localhost:1234"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
DEEPINFRA_BASE_URL="https://api.deepinfra.com/v1/openai"

# Cloud provider API keys (only the selected PROVIDER's key is required)
OPENAI_API_KEY="YOUR-API-KEY"
OPENROUTER_API_KEY="YOUR-API-KEY"
TOGETHER_API_KEY="YOUR-API-KEY"
DEEPINFRA_API_KEY="YOUR-API-KEY"

# Embeddings
# Any SentenceTransformer model id. Embeds title + summary (fallback title + description) per raw markdown file.
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Step 7 (wiki compile): see .env.pi.example
