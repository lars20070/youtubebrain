# Example of .env file
# Please rename this file to .env and fill in the placeholders.

# API keys
API_KEY_YOUTUBE="YOUR-API-KEY"  # Get API key from https://console.cloud.google.com For details see https://developers.google.com/youtube/registering_an_application

# Transcript pacing (optional)
# Seconds between each video in `uv run transcripts` (random uniform in [min, max]).
# Lower values speed up fetching but increase IP-block risk. Defaults: 3 and 7.
# min must be >= 0 and max >= min; invalid values fall back to defaults.
TRANSCRIPTS_SLEEP_MIN=3
TRANSCRIPTS_SLEEP_MAX=7

# Summary generation (optional)
# Local Ollama model used by `uv run summaries`. Defaults shown below; uncomment to override.
# SUMMARY_MODEL=qwen3:32b
# OLLAMA_BASE_URL=http://localhost:11434/v1
